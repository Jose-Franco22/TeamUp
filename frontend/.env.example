# "true" runs on fixture data; "false" runs against Supabase. Left unset, `npm run dev`
# uses mocks and a production build (Vercel) uses Supabase. Set it to "false" in Vercel.
VITE_USE_MOCKS=true
VITE_API_BASE=/api

# From Supabase project settings → API. The anon key is public/safe to ship
# to the browser — Row Level Security policies do the actual access control.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
