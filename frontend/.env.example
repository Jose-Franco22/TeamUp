# Set to "false" once Supabase is wired up to use real data instead of mocks.
VITE_USE_MOCKS=true
VITE_API_BASE=/api

# From Supabase project settings → API. The anon key is public/safe to ship
# to the browser — Row Level Security policies do the actual access control.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
